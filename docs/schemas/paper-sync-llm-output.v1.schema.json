{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daymark.app/schemas/paper-sync-llm-output.v1.schema.json",
  "title": "Paper Sync LLM output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "isPlannerPage",
    "legibility",
    "detectedPlannerType",
    "pageDate",
    "tasks",
    "notes",
    "ignoredRegions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "isPlannerPage": {
      "type": "boolean"
    },
    "legibility": {
      "enum": [
        "good",
        "fair",
        "poor"
      ]
    },
    "detectedPlannerType": {
      "enum": [
        "franklin",
        "daytimer",
        "generic"
      ]
    },
    "pageDate": {
      "anyOf": [
        {
          "$ref": "#/$defs/pageDate"
        },
        {
          "type": "null"
        }
      ]
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/note"
      }
    },
    "ignoredRegions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "pageDate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "confidenceLevel"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "confidenceLevel": {
          "$ref": "#/$defs/confidenceLevel"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "priority",
        "priorityOrder",
        "completed",
        "marker",
        "section",
        "readingOrder",
        "confidenceLevel",
        "status"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "priority": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "A",
            "B",
            "C",
            null
          ]
        },
        "priorityOrder": {
          "type": [
            "integer",
            "null"
          ]
        },
        "completed": {
          "type": "boolean"
        },
        "marker": {
          "type": [
            "string",
            "null"
          ]
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "readingOrder": {
          "type": "integer"
        },
        "confidenceLevel": {
          "$ref": "#/$defs/confidenceLevel"
        },
        "status": {
          "$ref": "#/$defs/taskStatus"
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "section",
        "readingOrder",
        "confidenceLevel"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "readingOrder": {
          "type": "integer"
        },
        "confidenceLevel": {
          "$ref": "#/$defs/confidenceLevel"
        }
      }
    },
    "confidenceLevel": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "taskStatus": {
      "enum": [
        "notStarted",
        "inProgress",
        "completed",
        "forwarded",
        "cancelled",
        "delegated",
        "unknown"
      ]
    }
  }
}
